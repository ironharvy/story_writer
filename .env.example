# Model configuration
MODEL=openai/gpt-4o-mini
LLM_URL=
# Provider-agnostic API key. LLM_API_KEY takes precedence, then API_KEY,
# then OPENAI_API_KEY (kept for back-compat).
LLM_API_KEY=
API_KEY=

# DSPy cache
DSPY_CACHE_DIR=

# Replicate (image generation)
REPLICATE_API_TOKEN=

# Logging
# LOG_LEVEL=INFO        # Override log level (DEBUG, INFO, WARNING, ERROR)
# LOG_FORMAT=text       # "text" for human-readable, "json" for structured
# LOG_FILE=             # Optional: set to a path to enable file logging (JSON). Unset = no file output.

# Langfuse (LLM observability — https://langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
